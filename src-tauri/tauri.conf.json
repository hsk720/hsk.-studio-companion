{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hsk. studio",
  "version": "0.4.5",
  "identifier": "photos.hsk.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "hsk. studio",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#23271f",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://hsk.photos data: blob:; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hsk"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "category": "Photography",
    "shortDescription": "Pozele din folderul de lucru, direct în albumul hsk. photos",
    "copyright": "© hsk. photos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Romanian",
          "English"
        ],
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "../setup/icons/setup.ico"
      }
    }
  }
}
