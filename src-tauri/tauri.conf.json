{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hsk. Studio Companion",
  "version": "0.1.0",
  "identifier": "photos.hsk.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "hsk. Studio Companion",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "backgroundColor": "#23271f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://hsk.photos data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hsk"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Photography",
    "shortDescription": "Pozele din folderul de lucru, direct în albumul hsk. photos",
    "copyright": "© hsk. photos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Romanian", "English"]
      }
    }
  }
}
