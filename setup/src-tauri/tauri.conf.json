{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hsk. studio Setup",
  "mainBinaryName": "hsk-studio-setup",
  "version": "../../package.json",
  "identifier": "photos.hsk.companion.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Instalare hsk. studio",
        "width": 780,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#111310"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../icons/setup.ico",
      "../icons/setup.png"
    ],
    "copyright": "© hsk. photos"
  }
}
